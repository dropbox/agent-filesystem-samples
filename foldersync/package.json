{
  "name": "foldersync",
  "version": "0.1.0-preview.1",
  "private": true,
  "description": "Folder sync sample for Agent Filesystem managed users",
  "main": "dist/main/main.js",
  "type": "commonjs",
  "scripts": {
    "app": "npm run build && electron .",
    "build": "tsc -p tsconfig.json && node scripts/css-types.mjs && tsc -p tsconfig.renderer.json --noEmit && node scripts/build-renderer.mjs && node scripts/copy-static.mjs",
    "build:tokenserver": "cd tokenserver && go build -o ../out/tokenserver .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" \"*.mjs\" \"*.mts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" \"*.mjs\" \"*.mts\"",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "package": "node scripts/package.mjs",
    "start": "npm run build && node scripts/start.mjs",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "typecheck": "node scripts/css-types.mjs && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "electron": "44.7.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-package-json": "1.10.1",
    "globals": "17.13.0",
    "happy-dom": "21.0.1",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-css-modules": "1.2.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=24"
  },
  "productName": "FolderSync"
}
